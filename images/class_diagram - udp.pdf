1708 0 obj
  << /ActualText (class Elevator \173\n  function is\137floor\137closer\137than\137destination\050floor\072 number\051 \173\n    int old\137dist \075 abs\050self\056destination\137floor \055 self\056last\137floor\051\n    int new\137dist \075 abs\050floor \055 self\056last\137floor\051\n    if old\137dist \074 new\137dist \173\n      return 0\n    \175\n    self\056destination\137floor \075 floor\n    return 1\n  \175\n  \n  function move\137to\137destination\050\051 \173\n    int dist \075 self\056destination\137floor \055 self\056last\137floor\n    \057\057 if dist is negative the elevator is above and needs to move down\054 if dist is positive the elevator needs to move up\n    \057\057 if dist is  0\054 the elevator can either be on the correct floor\054 or right above it\056 check current\137position\054 if it is not the same as last\137floor the elevator needs to turn back the other way to get to the correct floor\n  \175\n  \n  function run\137elevator\050\051 \173\n    switch \050e\055\076state\051\n    \173\n        case UNINITIALIZED\072\n            if \050at\137right\137floor\050e\051\051\n            \173\n                e\055\076request\137complete\137cbk\050e\051\073\n                if \050e\055\076request\051 \173 e\055\076state \075 MOTOR\137STOPPED\073 \175\n                else\n                \173\n                    e\055\076state \075 IDLE\073\n                \175\n                break\073\n            \175\n        case IDLE\072\n            if self\056destination\137floor \173 move\137to\137destination\050\051\073 \175\n            break\073\n        case MOVING\072\n            if \050at\137right\137floor\050e\051\051 \173 e\055\076state \075 MOTOR\137STOPPED\073 \175\n            break\073\n        case MOTOR\137STOPPED\072\n            if \050\041e\055\076request\051 \173 e\055\076state \075 IDLE\073 \175\n            break\073\n        case DOOR\137OPEN\072\n            if \050e\055\076time \075\075 0\051 \173 e\055\076time \075 time\050NULL\051\073 \175\n\n            if \050elevio\137obstruction\050\051\051\n            \173\n                e\055\076state \075 OBSTRUCTED\073\n                break\073\n            \175\n\n            \057\057 Check if 3 seconds have passed\n            if \050time\050NULL\051 \055 e\055\076time \076\075 3\051\n            \173\n                e\055\076time \075 0\073\n                e\055\076state \075 MOTOR\137STOPPED\073\n            \175\073\n\n            break\073\n        case EMERGENCY\137LOCK\072 break\073\n        case OBSTRUCTED\072\n            if \050\041elevio\137obstruction\050\051\051\n            \173\n                e\055\076time \075 0\073  \057\057 reset timer\n                e\055\076state \075 DOOR\137OPEN\073\n            \175\n            break\073\n    \175\n\175\n  \175\n\175)
